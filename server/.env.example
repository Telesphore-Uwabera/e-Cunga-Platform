PORT=5000
CLIENT_URL=http://localhost:5173
# Optional — transactional email (new company alerts, approvals, invite OTP). If unset, logs to console only.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# Or:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="e-Cunga <no-reply@yourdomain.com>"
JWT_SECRET=change-me-in-production
# Full stack: set MONGODB_URI (MongoDB connection string). Client must use the same API origin, e.g. in client/.env: VITE_API_URL=http://localhost:5000
MONGODB_URI=
# First-time demo data (requires MONGODB_URI): creates company_demo_1, users, stock, requisitions, notifications.
SEED_DEMO_WORKSPACE=false
# If true and Mongo has zero users, runs the demo seed on server start (good for local dev).
AUTO_SEED_DEMO_IF_EMPTY=true
SYNC_DB_ON_START=false
DATABASE_SETUP_KEY=
# Seeded workspace: one admin only. Clerk / supervisor / accountant / supplier: add via admin invites.
DEMO_COMPANY_NAME=e-Cunga Portal
DEMO_PASSWORD=change-me
DEMO_EMAIL_ADMIN=admin@example.com
DEMO_ADMIN_FULL_NAME=Your Admin Full Name
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — live workspace AI insights (OpenAI). Without this, portals show static fallback text only.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# OAuth providers - Google and Microsoft authentication
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
