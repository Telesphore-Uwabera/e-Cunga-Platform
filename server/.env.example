# SMTP_URL=smtps://user:pass@smtp.example.com:465
# Or:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="e-CUNGA <no-reply@yourdomain.com>"
JWT_SECRET=change-me-in-production
MONGODB_URI=
SEED_DEMO_WORKSPACE=false
AUTO_SEED_DEMO_IF_EMPTY=true
SYNC_DB_ON_START=false
DATABASE_SETUP_KEY=
DEMO_PASSWORD=Demo@1234
DEMO_EMAIL_ADMIN=admin@ecunga.com
DEMO_EMAIL_CLERK_ONE=clerk.one@ecunga.com
DEMO_EMAIL_CLERK_TWO=clerk.two@ecunga.com
DEMO_EMAIL_SUPERVISOR=supervisor@ecunga.com
DEMO_EMAIL_ACCOUNTANT=accountant@ecunga.com
DEMO_EMAIL_SUPPLIER=supplier@ecunga.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

