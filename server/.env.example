PORT=5000
CLIENT_URL=http://localhost:5173
# Optional — transactional email (new company alerts, approvals, invite OTP). If unset, logs to console only.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# Or:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="e-Cunga <no-reply@yourdomain.com>"
JWT_SECRET=change-me-in-production
# Full stack: set MONGODB_URI (MongoDB connection string). Client must use the same API origin, e.g. in client/.env: VITE_API_URL=http://localhost:5000
MONGODB_URI=
# First-time demo data (requires MONGODB_URI): creates company_demo_1, users, stock, requisitions, notifications.
SEED_DEMO_WORKSPACE=false
# If true and Mongo has zero users, runs the demo seed on server start (good for local dev).
AUTO_SEED_DEMO_IF_EMPTY=true
SYNC_DB_ON_START=false
DATABASE_SETUP_KEY=
# Display name for the seeded demo company (sidebar / institution); not the product name.
DEMO_COMPANY_NAME=Demo Regional Hospital
DEMO_PASSWORD=Demo@1234
DEMO_EMAIL_ADMIN=admin@ecunga.com
DEMO_EMAIL_CLERK_ONE=clerk.one@ecunga.com
DEMO_EMAIL_CLERK_TWO=clerk.two@ecunga.com
DEMO_EMAIL_SUPERVISOR=supervisor@ecunga.com
DEMO_EMAIL_ACCOUNTANT=accountant@ecunga.com
DEMO_EMAIL_SUPPLIER=supplier@ecunga.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — live workspace AI insights (OpenAI). Without this, portals show static fallback text only.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# OAuth providers - Google and Microsoft authentication
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
