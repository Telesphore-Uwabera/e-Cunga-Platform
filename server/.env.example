PORT=5000
# Production SPA origin (no trailing slash). Local: http://localhost:5173
CLIENT_URL=https://www.ecunga.com
# Optional — transactional email (new company alerts, approvals, invite OTP). If unset, logs to console only.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# Or:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="e-Cunga <no-reply@yourdomain.com>"
# Brevo (transactional email): https://app.brevo.com
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=no-reply@yourdomain.com
# BREVO_SENDER_NAME=e-Cunga Portal
# (Use "e-Cunga Portal" — not "Platform". Gmail shows this as the sender name next to your Brevo address.)
# Footer in all templates: support line, optional address, logo override
# MAIL_SUPPORT_EMAIL=support@yourdomain.com
# MAIL_SUPPORT_PHONE=+250 …
# MAIL_COMPANY_ADDRESS=e-Cunga Portal, Kigali, Rwanda
# Transparent logo (PNG/WebP with alpha) recommended. If unset, templates use an on-brand header mark (no white box).
# MAIL_BRAND_LOGO_URL=https://www.ecunga.com/assets/email-logo.png
JWT_SECRET=change-me-in-production
# Full stack: set MONGODB_URI (MongoDB connection string). Client must use the same API origin, e.g. in client/.env: VITE_API_URL=http://localhost:5000
MONGODB_URI=
# Dev-only: creates company_demo_1 + one admin from DEMO_* env vars. Ignored when NODE_ENV=production.
SEED_DEMO_WORKSPACE=false
# Dev-only: if true and Mongo has zero users, runs the demo seed on server start. Ignored when NODE_ENV=production.
AUTO_SEED_DEMO_IF_EMPTY=false
SYNC_DB_ON_START=false
DATABASE_SETUP_KEY=
# Seeded workspace: one admin only. Clerk / supervisor / accountant / supplier: add via admin invites.
DEMO_COMPANY_NAME=e-Cunga Portal
DEMO_PASSWORD=change-me
DEMO_EMAIL_ADMIN=admin@example.com
DEMO_ADMIN_FULL_NAME=Your Admin Full Name
# Optional: full URL to logo image. If unset, uses CLIENT_URL + /e-Cunga.webp (see client/public/e-Cunga.webp).
# DEMO_LOGO_URL=https://your-frontend.example.com/e-Cunga.webp
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — live workspace AI insights (OpenAI). Without this, portals show static fallback text only.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# OAuth providers - Google and Microsoft authentication
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
